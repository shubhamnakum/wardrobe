# Copy to .env (git-ignored). All keys optional; defaults shown.
WARDROBE_HOST=127.0.0.1
WARDROBE_PORT=8000
WARDROBE_DATA_DIR=./data
# Defaults below derive from WARDROBE_DATA_DIR when unset.
# WARDROBE_DB_PATH=./data/wardrobe.db
# WARDROBE_STORAGE_ROOT=./data/images
# WARDROBE_LOG_DIR=./data/logs
# Keep model weights outside the repo.
# WARDROBE_MODEL_DIR=C:/models/wardrobe
WARDROBE_LOG_LEVEL=INFO
# Inference device: auto | cuda | cpu
WARDROBE_DEVICE=auto
